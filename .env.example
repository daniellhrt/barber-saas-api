# Exemplo de variáveis de ambiente para desenvolvimento local
# Copie este arquivo para `.env` e preencha com seus valores reais
# NUNCA commite o arquivo `.env` — ele está no .gitignore

# === Banco de Dados (PostgreSQL) ===
DB_URL=jdbc:postgresql://localhost:5432/barbersaas_db
DB_USER=postgres
DB_PASS=sua_senha_segura
DB_NAME=barbersaas_db

# === JWT ===
# Gere uma chave segura com: openssl rand -hex 32
JWT_SECRET=troque_por_uma_chave_forte_com_minimo_32_caracteres
JWT_EXPIRATION_MS=86400000

# === Spring ===
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# === CORS ===
# Origens do frontend separadas por vírgula
# Produção: CORS_ALLOWED_ORIGINS=https://meuapp.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# === Fuso Horário ===
# Usado nos relatórios e dashboard
APP_TIME_ZONE=America/Sao_Paulo
