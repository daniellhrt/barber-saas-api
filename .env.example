# Example environment variables for local development and testing
# Copy this file to `.env` and fill in your actual values
# DO NOT commit `.env` to version control - it is ignored by .gitignore

# === Database Configuration ===
# Connection URL for PostgreSQL database
DB_URL=jdbc:postgresql://localhost:5432/barbersaas_db

# Database user (e.g., postgres)
DB_USER=postgres

# Database password (set to a secure password for local development)
DB_PASS=your_secure_password_here

# Database name
DB_NAME=barbersaas_db

# === JWT Configuration ===
# Secret key for signing JWT tokens (generate a strong key for production)
# Example: openssl rand -hex 32
JWT_SECRET=your_secure_jwt_secret_here_min_32_chars

# Token expiration time in milliseconds (default: 24 hours)
JWT_EXPIRATION_MS=86400000

# === Spring Configuration ===
# Active Spring profiles (dev, test, prod)
SPRING_PROFILES_ACTIVE=dev

# === Server Configuration ===
# HTTP port for the application
PORT=8080

